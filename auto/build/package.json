{
    "name": "auto",
    "version": "1.0.0",
    "main": "../main.js",
    "scripts": {
      "start": "electron .",
      "build": "electron-builder",
      "build:css": "echo 'Building CSS...'",
      "build:js": "echo 'Building JS...'",
      "build:html": "echo 'Building HTML...'",
      "build:server": "echo 'Building server.json...'",
      "build:all": "npm run build:css && npm run build:js && npm run build:html && npm run build:server",
      "watch:css": "chokidar 'style.css' -c 'npm run build:css'",
      "watch:js": "chokidar 'scripts.js' -c 'npm run build:js'",
      "watch:html": "chokidar 'index.html' -c 'npm run build:html'",
      "watch:server": "chokidar 'server.json' -c 'npm run build:server'",
      "watch:all": "concurrently \"npm:watch:css\" \"npm:watch:js\" \"npm:watch:html\" \"npm:watch:server\"",
      "dev": "npm run build:all && npm run watch:all",
      "test": "echo \"Error: no test specified\" && exit 1",
      "sass": "sass style.scss styles.css"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "description": "",
  
    "devDependencies": {
      "electron": "^25.3.0",
      "chokidar-cli": "^3.0.0",
      "concurrently": "^8.0.0",
      "electron-builder": "^24.6.4",
      "electron-packager": "^17.1.2",
      "electron-reload": "^1.5.0",
      "express": "^4.18.2",
      "groq-sdk": "^0.13.0"
    }
  }
  